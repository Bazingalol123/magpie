{
  "name": "Enrichment",
  "description": "An auditable field-level change detected during an enrichment check.",
  "type": "object",
  "properties": {
    "owner_id": { "type": "string", "description": "Dashboard user that owns the change history" },
    "record_id": { "type": "string", "description": "Record that changed" },
    "field": { "type": "string", "description": "Structured field that changed" },
    "old_value": { "type": "string", "description": "Previous serialized value" },
    "new_value": { "type": "string", "description": "Updated serialized value" },
    "checked_at": { "type": "string", "format": "date-time", "description": "When the source was checked" },
    "agent_id": { "type": "string", "description": "Identifier of the enrichment implementation" }
  },
  "required": ["owner_id", "record_id", "field", "old_value", "new_value", "checked_at", "agent_id"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "data.owner_id": "{{user.id}}" },
    "update": false,
    "delete": false
  }
}
