{
  "name": "ExtensionInstall",
  "description": "A browser installation paired to one dashboard owner through a hashed opaque token.",
  "type": "object",
  "properties": {
    "owner_id": { "type": "string", "description": "Dashboard user that paired this browser" },
    "label": { "type": "string", "description": "Human-readable browser label" },
    "token_hash": { "type": "string", "description": "SHA-256 hash of the token; the raw token is never stored" },
    "active": { "type": "boolean", "default": true, "description": "Whether this pairing may submit clips" },
    "created_at": { "type": "string", "format": "date-time", "description": "When the pairing was created" },
    "last_used_at": { "type": "string", "format": "date-time", "description": "Last successful ingestion through this pairing" }
  },
  "required": ["owner_id", "label", "token_hash", "active", "created_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.owner_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
