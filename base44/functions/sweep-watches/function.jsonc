{
  "name": "sweep-watches",
  "entry": "entry.ts",
  // Base44's own scheduled-function trigger, not the dashboard "Workflow"
  // builder -- that one requires binding to an Agent, and this function has
  // no AI/agent involvement at all. This is defined directly on the
  // function via the "automations" field the Base44 CLI already supports
  // (see docs/DECISIONS.md, 2026-08-25, for how this was found and why it's
  // preferred over the GitHub Actions cron fallback in
  // .github/workflows/sweep-watches.yml).
  //
  // UNVERIFIED: whether Base44 presents this trigger's caller as an
  // admin-role user (sweep-watches requires caller.role === "admin"). If
  // this automation gets rejected with 403 in practice, that's the reason --
  // report back and the auth check will need to change to recognize
  // automation-triggered calls, not just interactively logged-in admins.
  "automations": [
    {
      "name": "Sweep due watches every 15 minutes",
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 15,
      "is_active": true,
      "function_args": { "limit": 20 }
    }
  ]
}
