{
  "name": "magpie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.ui.config.ts",
    "record:onboarding-media": "playwright test --config=playwright.media.config.ts && node scripts/encode-onboarding-gifs.mjs",
    "browse:ios": "playwright open -b webkit --device=\"iPhone 14\" http://localhost:5173",
    "browse:android": "playwright open -b chromium --device=\"Pixel 7\" http://localhost:5173"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.3",
    "driver.js": "^1.8.0",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "base44": "^0.1.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
